# funds_marketdata 环境变量模板（复制为 .env 后按需修改）
# 完整清单见 src/funds.MarketData/core/config.py

# ---------- 日志 ----------
DEBUG=false

# ---------- Valkey ----------
VALKEY_HOST=valkey
VALKEY_PORT=6380
VALKEY_PASSWORD=

# ---------- 上游数据源地址 ----------
CFETS_BASE_URL=https://www.chinamoney.com.cn
CMTIDP_BASE_URL=http://eid.csrc.gov.cn
EASTMONEY_F10_BASE_URL=https://api.fund.eastmoney.com
EASTMONEY_FUND_BASE_URL=https://fund.eastmoney.com
# Playwright Cookie 网关地址
PLAYWRIGHT_GATEWAY_URL=http://funds.playwright.gateway:8081

# ---------- 健康检查 ----------
HEALTH_WINDOW_SIZE=20
HEALTH_MIN_SUCCESS_RATE=0.5
HEALTH_DOWN_MIN_SAMPLES=3
HEALTH_IDLE_SECONDS=600
HEALTH_PROBE_INTERVAL=300
HEALTH_PROBE_TIMEOUT=5.0
HEALTH_PROBE_MAX_PER_ROUND=3

# ---------- 雪球 K 线并发 ----------
XUEQIU_KLINE_CONCURRENCY=3
