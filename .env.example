# market-data-hub 环境变量模板（复制为 .env 后按需修改）
# 变量清单与默认值见 src/market-data/core/config.py

# ---------- 日志 ----------
DEBUG=false

# ---------- 进程内状态缓存 ----------
# 熔断状态 / 雪球 Cookie / yfinance 复权锚点落在此目录（容器内为 /app/data/state）；
# 报价短路缓存是纯内存的，不落盘。分层依据见 src/market-data/core/state_store.py
# STATE_DIR=data/state

# ---------- 上游数据源地址 ----------
CFETS_BASE_URL=https://www.chinamoney.com.cn
CMTIDP_BASE_URL=http://eid.csrc.gov.cn
EASTMONEY_F10_BASE_URL=https://api.fund.eastmoney.com
EASTMONEY_FUND_BASE_URL=https://fund.eastmoney.com

# 浏览器爬虫网关地址（BROWSER_PROXY_URL）
# 容器内由 compose 注入 http://browser-proxy-gateway:8081，此处供宿主机裸跑覆盖
# BROWSER_PROXY_URL=http://127.0.0.1:8081
# 雪球鉴权取 Cookie 的地址，默认取 BROWSER_PROXY_URL
# AUTH_SERVICE_URL=http://127.0.0.1:8081

# ---------- 健康检查 ----------
# 被动指标滑动窗口：统计最近 N 次调用
HEALTH_WINDOW_SIZE=20
# 成功率低于该值判定 degraded
HEALTH_MIN_SUCCESS_RATE=0.5
# 连续窗口内全部失败判定 down（窗口内至少这么多样本）
HEALTH_DOWN_MIN_SAMPLES=3
# 超过该秒数没有任何业务调用 → idle，触发主动探测兜底
HEALTH_IDLE_SECONDS=600
# 主动探测轮询间隔（秒）与单次超时（秒）
HEALTH_PROBE_INTERVAL=300
HEALTH_PROBE_TIMEOUT=5.0
# 每轮最多探测多少个源（错峰）
HEALTH_PROBE_MAX_PER_ROUND=3

# ---------- 取数超时与礼貌延时 ----------
UPSTREAM_TIMEOUT=30.0
UPSTREAM_PAGE_MIN_DELAY=0.2
UPSTREAM_PAGE_MAX_DELAY=0.5

# ---------- 雪球 K 线并发 ----------
XUEQIU_KLINE_CONCURRENCY=3

# ---------- 净值「已发布」口径 ----------
# 最近已发布交易日的截止时点（HH:MM），该时点前当日净值视为未披露
NAV_PUBLISH_CUTOFF=15:30

# ---------- 基金份额数据源参数 ----------
SSE_SHARE_MIN_DELAY=0.5
SSE_SHARE_MAX_DELAY=3.0

# ---------- 落盘目录（默认相对工作目录 /app） ----------
# 由 compose 挂载 ./src/market-data/data 持久化，一般无需改动
# ESTABLISH_CACHE_DIR=data
# LISTING_CACHE_DIR=data
# DELIST_CACHE_DIR=data
# 全量文件缓存的有效期（秒）
# ESTABLISH_STALE_SECONDS=86400
# LISTING_STALE_SECONDS=86400

# ---------- yfinance 可选走 Cloudflare Worker 中转 ----------
# YF_CF_WORKER_URL=
# YF_CF_WORKER_TOKEN=

# ---------- 分布式追踪 / 持续剖析（可选，不填则关闭） ----------
# 形如 http://<otel-collector>:4318（market-data 与爬虫网关都会读取）
# 与 funds dev 编排共网时填 http://aspire-dashboard:4318（funds 的 aspire-dashboard 已接入 mdh-net）
# OTEL_EXPORTER_OTLP_ENDPOINT=
# 采样比例，1 = 全量
# OTEL_TRACES_SAMPLER_ARG=1
# 形如 http://<pyroscope>:4040
# PYROSCOPE_SERVER_ADDRESS=

# ---------- 端口映射（compose 宿主端口，容器内端口固定） ----------
MARKET_DATA_PORT=8080
BROWSER_PROXY_PORT=8081
# 爬虫网关空闲多少秒后关停 browser-proxy 容器
BROWSER_PROXY_IDLE_LIMIT=300

# ---------- 时区 ----------
TZ=Asia/Shanghai